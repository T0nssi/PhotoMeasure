<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    PhotoMeasure Camera Bridge.
    Framework-dependent build: needs the ASP.NET Core Runtime 8 or newer (x64) on the PC.
    RollForward=Major lets it run on .NET 9/10 too (.NET 8 support ends Nov 2026).
    The Basler pylon .NET API is NOT referenced at build time: it is loaded at run time
    from the pylon installation (see Drivers/PylonDriver.cs). The same goes for the
    Hikrobot MVS runtime MvCameraControl.dll (see Drivers/HikrobotDriver.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CameraBridge</AssemblyName>
    <RootNamespace>CameraBridge</RootNamespace>
    <Version>0.6.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseAppHost>false</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
